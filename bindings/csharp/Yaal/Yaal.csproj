<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Yaal</RootNamespace>
    <PackageId>Yaal</PackageId>
    <Title>Yaal</Title>
    <Version>0.12.0</Version>
    <Authors>Kiruba Sankar Swaminathan</Authors>
    <Copyright>Copyright (c) 2026 Kiruba Sankar Swaminathan</Copyright>
    <Description>Yaal SQL compiler. Compiles Yaal SQL and a JSON parameter object into dialect SQL and ordered binds.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kirubasankars/yaal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirubasankars/yaal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>sql;compiler</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
